		<properties node_id="52" format="literal">{'C_index': 79, 'auto_apply': True, 'class_weight': False, 'controlAreaVisible': True, 'learner_name': '', 'penalty_type': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02@\x00\x00\x00\xed\x00\x00\x03K\x00\x00\x026\x00\x00\x02@\x00\x00\x01\t\x00\x00\x03K\x00\x00\x026\x00\x00\x00\x00\x02\x00\x00\x00\x05\xa0\x00\x00\x02@\x00\x00\x01\t\x00\x00\x03K\x00\x00\x026', '__version__': 2}</properties>
		<properties node_id="53" format="pickle">gASVyBgAAAAAAAB9lCiMC2F1dG9fY29tbWl0lIiMEmNvbnRyb2xBcmVhVmlzaWJsZZSIjBNpZ25v
