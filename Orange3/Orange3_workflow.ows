		<properties node_id="47" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x016\x00\x00\x00X\x00\x00\x05:\x00\x00\x02\xcb\x00\x00\x016\x00\x00\x00t\x00\x00\x05:\x00\x00\x02\xcb\x00\x00\x00\x00\x00\x00\x00\x00\x05\xa0\x00\x00\x016\x00\x00\x00t\x00\x00\x05:\x00\x00\x02\xcb', 'scriptLibrary': [], 'scriptText': '# Post-hoc comparison of several DBSCAN configurations.\n# The diagnosis is never used to construct the clusters.\n# It is used here only to evaluate the resulting partitions.\n\nimport numpy as np\nfrom Orange.data import (Domain,Table,ContinuousVariable,StringVariable)\nfrom scipy.optimize import linear_sum_assignment\nfrom sklearn.metrics import (adjusted_rand_score,normalized_mutual_info_score)\nfrom sklearn.metrics.cluster import contingency_matrix\n\n\n# This list follow exactly the order in which the DBSCAN widgets were connected to this Python Script widget.\nconfigurations = [("DBSCAN-e2.5-m5", 2.5, 5),\n    ("DBSCAN-e2.2-m5", 2.2, 5),\n    ("DBSCAN-e2.3-m5", 2.3, 5),\n    ("DBSCAN-e2.4-m5", 2.4, 5),\n    ("DBSCAN-e2.6-m5", 2.6, 5),\n    ("DBSCAN-e2.7-m5", 2.1, 5)]\n\nresults = []\nconfiguration_names = []\n\nfor configuration, data in zip(configurations, in_datas):\n    name, epsilon, min_samples = configuration\n\n    # Search all variables, including metadata.\n    variables = (list(data.domain.attributes)+ list(data.domain.class_vars)\n        + list(data.domain.metas))\n\n    # Diagnosis is retained only as metadata for post-hoc evaluation.\n    diagnosis_var = next(\n        variable\n        for variable in variables\n        if variable.name.lower() == "diagnosis")\n\n    # Find the cluster variable added by DBSCAN.\n    cluster_candidates = [\n        variable\n        for variable in variables\n        if "cluster" in variable.name.lower()\n    ]\n\n    if not cluster_candidates:\n        print(f"{name}: no cluster variable was found.")\n        continue\n    cluster_var = cluster_candidates[0]\n\n    # Extract diagnosis and cluster codes.\n    diagnosis = np.asarray(data.get_column(diagnosis_var),dtype=float)\n    clusters = np.asarray(data.get_column(cluster_var),dtype=float)\n\n    # Keep observations with both values available.\n    valid = (~np.isnan(diagnosis)&amp; ~np.isnan(clusters))\n    y_true = diagnosis[valid].astype(int)\n    y_cluster = clusters[valid].astype(int)\n\n    if len(y_true) == 0:\n        print(\n            f"{name}: no valid observations."\n        )\n        continue\n\n    # Identify observations labelled as noise by DBSCAN.\n    noise_mask = np.zeros(len(y_cluster),dtype=bool)\n    if getattr(cluster_var, "values", None):\n\n        for code, label in enumerate(cluster_var.values):\n            label_lower = str(label).lower()\n            if ("noise" in label_lower\n                or "outlier" in label_lower\n            ):\n                noise_mask |= y_cluster == code\n\n    noise_instances = int(noise_mask.sum())\n\n    # Count clusters without counting the noise category.\n    non_noise_labels = y_cluster[~noise_mask]\n\n    number_of_clusters = (len(np.unique(non_noise_labels))\n        if len(non_noise_labels) &gt; 0\n        else 0)\n\n    # Fraction of observations assigned to a real cluster.\n    coverage = (1.0 - noise_instances / len(y_cluster))\n\n    # ARI and NMI are calculated on all observations.\n    # Noise is treated as an additional cluster when present.\n    ari = adjusted_rand_score(y_true,y_cluster)\n    nmi = normalized_mutual_info_score(y_true,y_cluster)\n\n    # Find the best possible correspondence between\n    # DBSCAN cluster labels and diagnosis labels.\n    contingency = contingency_matrix(y_true,y_cluster)\n\n    row_indices, column_indices = (linear_sum_assignment(-contingency))\n\n    best_alignment = (contingency[row_indices,column_indices].sum()/ contingency.sum())\n\n    results.append([epsilon,min_samples,number_of_clusters,noise_instances,coverage,\n        ari,nmi,best_alignment])\n    configuration_names.append([name])\n\n\n# Construct the Orange output table.\ndomain = Domain(\n    [ContinuousVariable("Epsilon"),ContinuousVariable("Min samples"),\n     ContinuousVariable("Number of clusters"),ContinuousVariable("Noise instances"),\n     ContinuousVariable("Coverage"),ContinuousVariable("ARI"),\n     ContinuousVariable("NMI"),ContinuousVariable("Best alignment")],\n    metas=[StringVariable("Configuration")])\n\n\nout_data = Table.from_numpy(domain,np.asarray(results, dtype=float),metas=np.asarray(\n        configuration_names,dtype=object))\n\nout_data.name = "DBSCAN parameter comparison"', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="48" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01=\x00\x00\x01\x10\x00\x00\x05\x9f\x00\x00\x03\x83\x00\x00\x01=\x00\x00\x01,\x00\x00\x05\x9f\x00\x00\x03\x83\x00\x00\x00\x00\x00\x00\x00\x00\x05\xa0\x00\x00\x01=\x00\x00\x01,\x00\x00\x05\x9f\x00\x00\x03\x83', 'scriptLibrary': [], 'scriptText': 'import numpy as np\nfrom Orange.data import (Domain,Table,ContinuousVariable,StringVariable)\nfrom sklearn.cluster import SpectralClustering\nfrom sklearn.metrics import (silhouette_score,adjusted_rand_score,normalized_mutual_info_score)\nfrom sklearn.metrics.cluster import contingency_matrix\nfrom scipy.optimize import linear_sum_assignment\n\n# Data\ndata = in_data\nif data is None:\n    raise ValueError("Aucune donnée reçue par le widget Python Script.")\n\nX = np.asarray(data.X, dtype=float)\n\nif X.shape[0] == 0:\n    raise ValueError("Le jeu de données est vide.")\n\nif not np.isfinite(X).all():\n    raise ValueError("X contient encore des valeurs manquantes ou infinies. "\n        "Connecte les données imputées au script.")\n\n# feature diagnosis\n\nall_variables = (\n    list(data.domain.attributes)\n    + list(data.domain.class_vars)\n    + list(data.domain.metas)\n)\n\ndiagnosis_var = next(\n    (\n        variable\n        for variable in all_variables\n        if variable.name.lower() in {\n            "diagnosis",\n            "diagnostic",\n            "class",\n            "target"\n        }\n    ),\n    None\n)\n\nif diagnosis_var is None:\n    available_names = [\n        variable.name\n        for variable in all_variables\n    ]\n\n    raise ValueError(\n        "Variable Diagnosis introuvable. Variables disponibles : "\n        + ", ".join(available_names)\n    )\n\nraw_diagnosis = np.asarray(\n    data.get_column(diagnosis_var)\n)\n\n# conversion of M/B\ndiagnosis_text = np.asarray(\n    [str(value) for value in raw_diagnosis],\n    dtype=object\n)\n\n# True for every dg validated\nvalid_diagnosis = np.asarray(\n    [\n        value.lower() not in {\n            "",\n            "?",\n            "nan",\n            "none"\n        }\n        for value in diagnosis_text\n    ],\n    dtype=bool\n)\n\n_, y_true = np.unique(\n    diagnosis_text[valid_diagnosis],\n    return_inverse=True)\n\n# Parameters\n\nneighbors_values = [5, 8, 10, 15, 20, 30, 40]\ngamma_values = [0.01, 0.03, 0.1, 0.3, 1.0, 3.0]\nlabel_methods = ["kmeans","discretize","cluster_qr"]\n\n# Metrics\n\ndef best_label_alignment(y_reference, cluster_labels):\n    """best alignement between cluster and diagnosis."""\n    matrix = contingency_matrix(y_reference, cluster_labels)\n    rows, columns = linear_sum_assignment(-matrix)\n    return matrix[rows, columns].sum() / matrix.sum()\n\ndef evaluate_configuration(labels):\n    """calculate the metrics"""\n    unique_labels, counts = np.unique(labels, return_counts=True)\n    number_of_clusters = len(unique_labels)\n\n    if 1 &lt; number_of_clusters &lt; len(labels):\n        silhouette = silhouette_score(X, labels)\n    else:\n        silhouette = np.nan\n\n    labels_for_metrics = labels[valid_diagnosis]\n    ari = adjusted_rand_score(y_true,labels_for_metrics)\n    nmi = normalized_mutual_info_score(y_true,labels_for_metrics)\n    alignment = best_label_alignment(y_true,labels_for_metrics)\n    smallest_cluster = int(counts.min())\n    largest_cluster = int(counts.max())\n\n    return (number_of_clusters,smallest_cluster,largest_cluster,silhouette,ari,nmi,alignment)\n\nresults = []\nmetadata = []\n\n\n# Affinity = Neirest_neighbors\n\nfor n_neighbors in neighbors_values:\n    if n_neighbors &gt;= len(X):\n        continue\n    for label_method in label_methods:\n        configuration_name = (f"Spectral-NN-k{n_neighbors}-{label_method}")\n\n        try:\n            model = SpectralClustering(n_clusters=2,affinity="nearest_neighbors",n_neighbors=n_neighbors,\n                assign_labels=label_method,n_init=30,eigen_solver="arpack",random_state=42)\n            labels = model.fit_predict(X)\n            (number_of_clusters,smallest_cluster,largest_cluster,silhouette,ari,nmi,alignment\n             ) = evaluate_configuration(labels)\n\n            results.append([float(n_neighbors),np.nan,number_of_clusters,smallest_cluster,largest_cluster,\n                            silhouette,ari,nmi,alignment])\n            metadata.append([configuration_name,"nearest_neighbors",label_method])\n\n        except Exception as error:\n            print(f"Erreur pour {configuration_name} : {error}")\n\n# Affinity = RBF\n\nfor gamma in gamma_values:\n    for label_method in label_methods:\n        configuration_name = (f"Spectral-RBF-g{gamma}-{label_method}")\n\n        try:\n            model = SpectralClustering(n_clusters=2,affinity="rbf",gamma=gamma,assign_labels=label_method,\n                n_init=30,eigen_solver="arpack",random_state=42)\n            labels = model.fit_predict(X)\n            (number_of_clusters,smallest_cluster,largest_cluster,silhouette,ari,nmi,alignment\n             ) = evaluate_configuration(labels)\n            results.append([np.nan,gamma,number_of_clusters,smallest_cluster,largest_cluster,silhouette,ari,\n                            nmi,alignment])\n            metadata.append([configuration_name,"rbf",label_method])\n\n        except Exception as error:\n            print(f"Erreur pour {configuration_name} : {error}")\n\n# arrange by silhouette \n\nresults_array = np.asarray(results, dtype=float)\nmetadata_array = np.asarray(metadata, dtype=object)\nsilhouette_column = results_array[:, 5]\nsorting_order = np.argsort(-np.nan_to_num(silhouette_column,nan=-np.inf))\n\n\nresults_array = results_array[sorting_order]\nmetadata_array = metadata_array[sorting_order]\n\n#Creation of the table\n\noutput_domain = Domain(\n    [ContinuousVariable("Neighbors"),ContinuousVariable("Gamma"),ContinuousVariable("Number of clusters"),\n        ContinuousVariable("Smallest cluster"),ContinuousVariable("Largest cluster"),\n        ContinuousVariable("Silhouette"),ContinuousVariable("ARI"),ContinuousVariable("NMI"),\n        ContinuousVariable("Best alignment")],\n    metas=[StringVariable("Configuration"),StringVariable("Affinity"),StringVariable("Assign labels")])\n\nout_data = Table.from_numpy(output_domain,results_array,metas=metadata_array)\nout_data.name = "Spectral clustering parameter comparison"', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
