		<properties node_id="127" format="literal">{'autocommit': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\x1e\x00\x00\x00\x89\x00\x00\x04k\x00\x00\x02\x98\x00\x00\x01\x1e\x00\x00\x00\xa5\x00\x00\x04k\x00\x00\x02\x98\x00\x00\x00\x00\x00\x00\x00\x00\x05\xa0\x00\x00\x01\x1e\x00\x00\x00\xa5\x00\x00\x04k\x00\x00\x02\x98', 'storedsettings': {'name': '', 'preprocessors': [('orange.preprocess.impute', {}), ('orange.preprocess.scale', {})]}, '__version__': 2}</properties>
		<properties node_id="128" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x016\x00\x00\x00W\x00\x00\x04U\x00\x00\x02\xca\x00\x00\x016\x00\x00\x00s\x00\x00\x04U\x00\x00\x02\xca\x00\x00\x00\x00\x00\x00\x00\x00\x05\xa0\x00\x00\x016\x00\x00\x00s\x00\x00\x04U\x00\x00\x02\xca', 'scriptLibrary': [], 'scriptText': 'import numpy as np\nfrom sklearn.cluster import SpectralClustering\nfrom Orange.data import DiscreteVariable\n\nX = np.asarray(in_data.X, dtype=float)\n\nmodel = SpectralClustering(\n    n_clusters=2,\n    affinity="nearest_neighbors",\n    n_neighbors=10,\n    assign_labels="kmeans",\n    n_init=10,\n    eigen_solver="arpack",\n    random_state=42)\n\nlabels = model.fit_predict(X)\n\ncluster_variable = DiscreteVariable(\n    "Cluster",\n    values=("C1", "C2")\n)\n\nout_data = in_data.add_column(\n    cluster_variable,\n    labels.astype(float),\n    to_metas=True\n)\n\nout_data.name = "Spectral initial NN10 kmeans"\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="129" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01k\x00\x00\x00\x81\x00\x00\x04\x8a\x00\x00\x02\xf4\x00\x00\x01k\x00\x00\x00\x9d\x00\x00\x04\x8a\x00\x00\x02\xf4\x00\x00\x00\x00\x00\x00\x00\x00\x05\xa0\x00\x00\x01k\x00\x00\x00\x9d\x00\x00\x04\x8a\x00\x00\x02\xf4', 'scriptLibrary': [], 'scriptText': 'import numpy as np\nfrom sklearn.cluster import SpectralClustering\nfrom Orange.data import DiscreteVariable\n\n\nif in_data is None:\n    raise ValueError("Aucune donnée reçue.")\n\nX = np.asarray(in_data.X, dtype=float)\n\nmodel = SpectralClustering(\n    n_clusters=2,\n    affinity="nearest_neighbors",\n    n_neighbors=15,\n    assign_labels="kmeans",\n    n_init=30,\n    eigen_solver="arpack",\n    random_state=42)\n\n# Clusters\nlabels = model.fit_predict(X)\n\n# Result as metadata\ncluster_variable = DiscreteVariable(\n    "Cluster",values=("C1", "C2"))\n\nout_data = in_data.add_column(\n    cluster_variable,\n    labels.astype(float),\n    to_metas=True)\n\nout_data.name = "Spectral tuned NN15 kmeans"\n\ncluster_variable = DiscreteVariable(\n    "Cluster",\n    values=("C1", "C2")\n)\n\nout_data = in_data.add_column(\n    cluster_variable,\n    labels.astype(float),\n    to_metas=True\n)\n\nout_data.name = "Spectral tuned NN15 kmeans"', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="130" format="literal">{'autocommit': True, 'axis': 0, 'controlAreaVisible': True, 'metric_id': 1, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02\n\x00\x00\x00\xfa\x00\x00\x03}\x00\x00\x02)\x00\x00\x02\n\x00\x00\x01\x16\x00\x00\x03\x81\x00\x00\x02)\x00\x00\x00\x00\x02\x00\x00\x00\x05\xa0\x00\x00\x02\n\x00\x00\x01\x16\x00\x00\x03}\x00\x00\x02)', '__version__': 4}</properties>
