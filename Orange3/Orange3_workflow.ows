e(X[sil_mask], labels_for_sil)\n    print(f"Silhouette (variables standardisées): {silhouette:.4f}")\nelse:\n    print("Silhouette non calculable: moins de deux clusters exploitables.")\n\nprint("Rows:", list(diagnosis_var.values))\nprint("Columns:", list(cluster_var.values))\nprint("Contingency table:")\nprint(table)\nprint(f"Adjusted Rand Index: {ari:.4f}")\nprint(f"Normalized Mutual Information: {nmi:.4f}")\nprint(f"Best label-cluster alignment: {alignment:.4f}")\n\nout_data = in_data\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
