		<properties node_id="50" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': None, 'scriptLibrary': [], 'scriptText': '# Evaluate clusters after construction; diagnosis is never used to fit them.\nimport numpy as np\nfrom scipy.optimize import linear_sum_assignment\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.metrics import adjusted_rand_score, normalized_mutual_info_score, silhouette_score\nfrom sklearn.metrics.cluster import contingency_matrix\nfrom sklearn.preprocessing import StandardScaler\n\ndata = in_data\nvariables = list(data.domain.attributes) + list(data.domain.class_vars) + list(data.domain.metas)\ndiagnosis_var = next(var for var in variables if var.name.lower() == "diagnosis")\ncluster_var = next(var for var in variables if var.name.lower() == "cluster")\n\ndiagnosis = np.asarray(data.get_column(diagnosis_var), dtype=float)\nclusters = np.asarray(data.get_column(cluster_var), dtype=float)\nvalid = ~np.isnan(diagnosis) &amp; ~np.isnan(clusters)\ny_true = diagnosis[valid].astype(int)\ny_cluster = clusters[valid].astype(int)\n\ntable = contingency_matrix(y_true, y_cluster)\nrows, cols = linear_sum_assignment(-table)\nalignment = table[rows, cols].sum() / table.sum()\n\nari = adjusted_rand_score(y_true, y_cluster)\nnmi = normalized_mutual_info_score(y_true, y_cluster)\n\nX = np.asarray(data.X[valid], dtype=float)\nX = SimpleImputer(strategy="median").fit_transform(X)\nX = StandardScaler().fit_transform(X)\n\n# For DBSCAN, omit the noise category from silhouette when Orange names it Noise.\nsil_mask = np.ones(len(y_cluster), dtype=bool)\nif getattr(cluster_var, "values", None):\n    for code, label in enumerate(cluster_var.values):\n        if str(label).lower().startswith("noise"):\n            sil_mask &amp;= y_cluster != code\n\nlabels_for_sil = y_cluster[sil_mask]\nif len(np.unique(labels_for_sil)) &gt;= 2 and len(labels_for_sil) &gt; len(np.unique(labels_for_sil)):\n    silhouette = silhouette_score(X[sil_mask], labels_for_sil)\n    print(f"Silhouette (variables standardisées): {silhouette:.4f}")\nelse:\n    print("Silhouette non calculable: moins de deux clusters exploitables.")\n\nprint("Rows:", list(diagnosis_var.values))\nprint("Columns:", list(cluster_var.values))\nprint("Contingency table:")\nprint(table)\nprint(f"Adjusted Rand Index: {ari:.4f}")\nprint(f"Normalized Mutual Information: {nmi:.4f}")\nprint(f"Best label-cluster alignment: {alignment:.4f}")\n\nout_data = in_data\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="51" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': None, 'scriptLibrary': [], 'scriptText': '# Spectral clustering with the diagnosis kept only as metadata.\nimport numpy as np\nfrom Orange.data import DiscreteVariable\nfrom sklearn.cluster import SpectralClustering\nfrom sklearn.preprocessing import StandardScaler\n\ndata = in_data\nX = np.asarray(data.X, dtype=float).copy()\n\n# Median imputation is fitted on this unsupervised dataset only.\nmedians = np.nanmedian(X, axis=0)\nrows, cols = np.where(np.isnan(X))\nX[rows, cols] = medians[cols]\nX = StandardScaler().fit_transform(X)\n\nlabels = SpectralClustering(\n    n_clusters=2,\n    affinity="nearest_neighbors",\n    n_neighbors=10,\n    assign_labels="kmeans",\n    random_state=42,\n).fit_predict(X)\n\ncluster = DiscreteVariable("Cluster", values=("C1", "C2"))\nout_data = data.add_column(cluster, labels.astype(float), to_metas=True)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
