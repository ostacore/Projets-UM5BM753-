		<properties node_id="95" format="literal">{'activation_index': 3, 'alpha_index': 28, 'auto_apply': True, 'controlAreaVisible': True, 'hidden_layers_input': '10,5', 'learner_name': '', 'max_iterations': 3000, 'replicable': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02\x1d\x00\x00\x00\xd8\x00\x00\x03l\x00\x00\x02M\x00\x00\x02\x1d\x00\x00\x00\xf4\x00\x00\x03o\x00\x00\x02K\x00\x00\x00\x00\x02\x00\x00\x00\x05\xa0\x00\x00\x02\x1d\x00\x00\x00\xf4\x00\x00\x03l\x00\x00\x02M', 'solver_index': 2, '__version__': 2}</properties>
		<properties node_id="96" format="literal">{'autocommit': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\x1e\x00\x00\x00\x89\x00\x00\x04k\x00\x00\x02\x98\x00\x00\x01\x1e\x00\x00\x00\xa5\x00\x00\x04k\x00\x00\x02\x98\x00\x00\x00\x00\x00\x00\x00\x00\x05\xa0\x00\x00\x01\x1e\x00\x00\x00\xa5\x00\x00\x04k\x00\x00\x02\x98', 'storedsettings': {'name': '', 'preprocessors': [('orange.preprocess.impute', {}), ('orange.preprocess.scale', {})]}, '__version__': 2}</properties>
		<properties node_id="97" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01"\x00\x00\x00&lt;\x00\x00\x05\x8b\x00\x00\x02\xaf\x00\x00\x01"\x00\x00\x00X\x00\x00\x05\x8b\x00\x00\x02\xaf\x00\x00\x00\x00\x00\x00\x00\x00\x05\xa0\x00\x00\x01"\x00\x00\x00X\x00\x00\x05\x8b\x00\x00\x02\xaf', 'scriptLibrary': [], 'scriptText': '# Comparison of the clustering models\n\n# Librairy and functions importation\nimport numpy as np\nfrom Orange.data import (Domain,Table,ContinuousVariable,StringVariable)\nfrom scipy.optimize import linear_sum_assignment\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import (silhouette_score,adjusted_rand_score,normalized_mutual_info_score)\nfrom sklearn.metrics.cluster import contingency_matrix\n\n\n# Method names (they must follow the order of connection)\n\nmethod_names = [\n    "DBSCAN_2.5",\n    "Ward (k=2)",\n    "K-means (k=2)",\n    "Spectral tuned (NN=15)",\n    "Spectral initial (NN=10)",\n    "DBSCAN_2.20"\n]\n\n\nresults = []\nresult_names = []\n\n\nfor method, data in zip(method_names, in_datas):\n\n    # research of diagnossi and Clusters.\n    variables = (list(data.domain.attributes) + list(data.domain.class_vars) + list(data.domain.metas))\n\n    diagnosis_var = next(var for var in variables\n                         if var.name.lower() == "diagnosis")\n\n    cluster_var = next(var for var in variables\n                       if var.name.lower() == "cluster")\n\n    # Extract the diagnosis and cluster.\n    diagnosis = np.asarray(data.get_column(diagnosis_var),dtype=float)\n    clusters = np.asarray(data.get_column(cluster_var),dtype=float)\n\n    # Exlusion of missing data.\n    valid = ~np.isnan(diagnosis) &amp; ~np.isnan(clusters)\n\n    y_true = diagnosis[valid].astype(int)\n    y_cluster = clusters[valid].astype(int)\n\n    # noise mask.\n    noise_mask = np.zeros(len(y_cluster), dtype=bool)\n\n    if getattr(cluster_var, "values", None):\n        for code, label in enumerate(cluster_var.values):\n            if str(label).lower().startswith("noise"):\n                noise_mask |= y_cluster == code\n\n    n_noise = int(noise_mask.sum())\n\n    # reel cluster number, without the noise by DBSCAN.\n    non_noise_labels = y_cluster[~noise_mask]\n    n_clusters = len(np.unique(non_noise_labels))\n\n    # preparation of result for the silhouette.\n    X = np.asarray(data.X[valid], dtype=float)\n\n    X = SimpleImputer(\n        strategy="median"\n    ).fit_transform(X)\n\n    X = StandardScaler().fit_transform(X)\n\n    # For DBSCAN, the silhouette is calculated without noisy points.\n    usable = ~noise_mask\n\n    labels_for_silhouette = y_cluster[usable]\n    X_for_silhouette = X[usable]\n\n    unique_labels = np.unique(labels_for_silhouette)\n\n    if (len(unique_labels) &gt;= 2\n        and len(labels_for_silhouette) &gt; len(unique_labels)):\n        silhouette = silhouette_score(\n            X_for_silhouette,\n            labels_for_silhouette)\n    else:\n        silhouette = np.nan\n\n    # Agreement between diagnosis and result.\n    ari = adjusted_rand_score(y_true, y_cluster)\n\n    nmi = normalized_mutual_info_score(y_true,y_cluster)\n\n    # best alignement between cluster and diagnosis.\n    contingency = contingency_matrix(y_true,y_cluster)\n    row_ind, col_ind = linear_sum_assignment(-contingency)\n    alignment = (contingency[row_ind, col_ind].sum()/ contingency.sum())\n\n    results.append([n_clusters,n_noise,silhouette,ari,nmi,alignment])\n    result_names.append([method])\n\n\n# Creation of a table.\ndomain = Domain([ContinuousVariable("Number of clusters"),ContinuousVariable("Noise instances"),\n                 ContinuousVariable("Silhouette"),ContinuousVariable("ARI"),ContinuousVariable("NMI"),\n                 ContinuousVariable("Best alignment")],\n                metas=[StringVariable("Method")])\n\nout_data = Table.from_numpy(domain,np.asarray(results, dtype=float),metas=np.asarray(result_names, \n                                                                                     dtype=object))\n\nout_data.name = "Clustering comparison"', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
