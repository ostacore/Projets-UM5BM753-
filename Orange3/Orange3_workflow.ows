		<properties node_id="120" format="literal">{'append_source_column': True, 'auto_commit': True, 'controlAreaVisible': True, 'ignore_compute_value': False, 'ignore_names': False, 'merge_type': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\xff\x00\x00\x00w\x00\x00\x03V\x00\x00\x02:\x00\x00\x02\x00\x00\x00\x00\x96\x00\x00\x03U\x00\x00\x029\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x02\x00\x00\x00\x00\x96\x00\x00\x03U\x00\x00\x029', 'source_attr_name': 'Source ID', 'source_column_role': 0, '__version__': 1}</properties>
		<properties node_id="121" format="literal">{'autocommit': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\x05\x00\x00\x00O\x00\x00\x04P\x00\x00\x02b\x00\x00\x01\x06\x00\x00\x00n\x00\x00\x04O\x00\x00\x02a\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x01\x06\x00\x00\x00n\x00\x00\x04O\x00\x00\x02a', 'storedsettings': {'name': '', 'preprocessors': [('orange.preprocess.scale', {}), ('orange.preprocess.impute', {})]}, '__version__': 2}</properties>
		<properties node_id="122" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\x1b\x00\x00\x00&lt;\x00\x00\x04&lt;\x00\x00\x02\xb3\x00\x00\x01\x1c\x00\x00\x00[\x00\x00\x04;\x00\x00\x02\xb2\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x01\x1c\x00\x00\x00[\x00\x00\x04;\x00\x00\x02\xb2', 'scriptLibrary': [], 'scriptText': 'import numpy as np\nfrom sklearn.cluster import SpectralClustering\nfrom Orange.data import DiscreteVariable\n\n\nif in_data is None:\n    raise ValueError("Aucune donnée reçue.")\n\nX = np.asarray(in_data.X, dtype=float)\n\nmodel = SpectralClustering(\n    n_clusters=2,\n    affinity="nearest_neighbors",\n    n_neighbors=15,\n    assign_labels="kmeans",\n    n_init=30,\n    eigen_solver="arpack",\n    random_state=42)\n\n# Clusters\nlabels = model.fit_predict(X)\n\n# Result as metadata\ncluster_variable = DiscreteVariable(\n    "Cluster",values=("C1", "C2"))\n\nout_data = in_data.add_column(\n    cluster_variable,\n    labels.astype(float),\n    to_metas=True)\n\nout_data.name = "Spectral tuned NN15 kmeans"\n\ncluster_variable = DiscreteVariable(\n    "Cluster",\n    values=("C1", "C2")\n)\n\nout_data = in_data.add_column(\n    cluster_variable,\n    labels.astype(float),\n    to_metas=True\n)\n\nout_data.name = "Spectral tuned NN15 kmeans"', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
