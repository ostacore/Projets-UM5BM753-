		<properties node_id="104" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x1f\x00\x00\x05\x9f\x00\x00\x03\x83\x00\x00\x00\x00\x00\x00\x00;\x00\x00\x05\x9f\x00\x00\x038\x00\x00\x00\x00\x02\x00\x00\x00\x05\xa0\x00\x00\x00\x00\x00\x00\x00;\x00\x00\x05\x9f\x00\x00\x03\x83', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [('ARI', -1)], '__version__': 1}</properties>
		<properties node_id="105" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x1f\x00\x00\x05\x9f\x00\x00\x03:\x00\x00\x00\x01\x00\x00\x00&lt;\x00\x00\x05\x9e\x00\x00\x039\x00\x00\x00\x00\x02\x00\x00\x00\x05\xa0\x00\x00\x00\x00\x00\x00\x00;\x00\x00\x05\x9f\x00\x00\x03:', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [('ARI', -1)], '__version__': 1}</properties>
		<properties node_id="106" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\x1b\x00\x00\x00&lt;\x00\x00\x04&lt;\x00\x00\x02\xb3\x00\x00\x01\x1c\x00\x00\x00[\x00\x00\x04;\x00\x00\x02\xb2\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x01\x1c\x00\x00\x00[\x00\x00\x04;\x00\x00\x02\xb2', 'scriptLibrary': [], 'scriptText': 'import numpy as np\nfrom sklearn.cluster import SpectralClustering\nfrom Orange.data import DiscreteVariable\n\n\nif in_data is None:\n    raise ValueError("Aucune donnée reçue.")\n\nX = np.asarray(in_data.X, dtype=float)\n\nmodel = SpectralClustering(\n    n_clusters=2,\n    affinity="nearest_neighbors",\n    n_neighbors=15,\n    assign_labels="kmeans",\n    n_init=30,\n    eigen_solver="arpack",\n    random_state=42)\n\n# Clusters\nlabels = model.fit_predict(X)\n\n# Result as metadata\ncluster_variable = DiscreteVariable(\n    "Cluster",values=("C1", "C2"))\n\nout_data = in_data.add_column(\n    cluster_variable,\n    labels.astype(float),\n    to_metas=True)\n\nout_data.name = "Spectral tuned NN15 kmeans"\n\ncluster_variable = DiscreteVariable(\n    "Cluster",\n    values=("C1", "C2")\n)\n\nout_data = in_data.add_column(\n    cluster_variable,\n    labels.astype(float),\n    to_metas=True\n)\n\nout_data.name = "Spectral tuned NN15 kmeans"', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="107" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x015\x00\x00\x00T\x00\x00\x04V\x00\x00\x02\xcb\x00\x00\x016\x00\x00\x00s\x00\x00\x04U\x00\x00\x02\xca\x00\x00\x00\x00\x00\x00\x00\x00\x05V\x00\x00\x016\x00\x00\x00s\x00\x00\x04U\x00\x00\x02\xca', 'scriptLibrary': [], 'scriptText': 'import numpy as np\nfrom sklearn.cluster import SpectralClustering\nfrom Orange.data import DiscreteVariable\n\nX = np.asarray(in_data.X, dtype=float)\n\nmodel = SpectralClustering(\n    n_clusters=2,\n    affinity="nearest_neighbors",\n    n_neighbors=10,\n    assign_labels="kmeans",\n    n_init=10,\n    eigen_solver="arpack",\n    random_state=42)\n\nlabels = model.fit_predict(X)\n\ncluster_variable = DiscreteVariable(\n    "Cluster",\n    values=("C1", "C2")\n)\n\nout_data = in_data.add_column(\n    cluster_variable,\n    labels.astype(float),\n    to_metas=True\n)\n\nout_data.name = "Spectral initial NN10 kmeans"\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
