		<properties node_id="25" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x016\x00\x00\x00X\x00\x00\x04U\x00\x00\x02\xcb\x00\x00\x016\x00\x00\x00t\x00\x00\x04U\x00\x00\x02\xcb\x00\x00\x00\x00\x00\x00\x00\x00\x05\xa0\x00\x00\x016\x00\x00\x00t\x00\x00\x04U\x00\x00\x02\xcb', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': '# Import numpy for numerical operation and for missing value detection\nimport numpy as np\n\n#import metrics from scikit-learn\nfrom sklearn.metrics import adjusted_rand_score\nfrom sklearn.metrics import normalized_mutual_info_score\nfrom sklearn.metrics.cluster import contingency_matrix\n\n# Retrieve the data set received from the K-means widget.\n# At this stage, the data set contains both the original diagnosis metadata and the cluster assignement generated without using the diagnosis labels.\ndata = in_data\n\n# Collect all variable from Orange domain\n# The diagnosis and cluster variables may be stored as metadata, so attributes, class variables and metadata are all inspected.\nvariables = (list(data.domain.attributes)+ list(data.domain.class_vars)\n             + list(data.domain.metas))\n\n# Identify the diagnosis variable by its name.\n# Diagnosis was not used to construct the clusters, it is retrieved here only for evaluation later.\ndiagnosis_var = next(var for var in variables if var.name.lower() ==\n                     "diagnosis")\n\n# Identify the cluster variable added by the K-Means widget.\ncluster_var = next(var for var in variables if var.name.lower() ==\n                   "cluster")\n\n# Extract the numerical codes representing the known diagnoses.\ndiagnosis = data.get_column(diagnosis_var)\n\n# Extract the numerical codes representing the K-Means clusters.\nclusters = data.get_column(cluster_var)\n\n# Retain only observations for which both diagnosis and cluster are available.\n# This prevents missing values from affecting the evaluation metrics.\nvalid = ~np.isnan(diagnosis) &amp; ~np.isnan(clusters)\ndiagnosis = diagnosis[valid].astype(int)\nclusters = clusters[valid].astype(int)\n\n# Construct a contingency table between diagnoses and clusters.\n# Rows correspond to diagnosis classes and columns correspond to clusters.\n# This table shows the post-hoc correspondence between the two partitions.\ntable = contingency_matrix(diagnosis, clusters)\n\n# Compute the Adjusted Rand Index : ARI measures agreement between two partitions while correcting for agreement that could occur by chance. A value of 1 indicates perfect agreement and a value near 0 indicates agreement comparable to random partitions.\nari = adjusted_rand_score(diagnosis, clusters)\n\n# Compute Normalized Mutual Information: NMI measures how much information about diagnosis is contained, in the cluster assignments, independently of cluster names. A value of 1 indicates perfect correspondence.\nnmi = normalized_mutual_info_score(diagnosis, clusters)\n\n# Cluster names such as C1 and C2 are arbitrary.\n# For two classes and two clusters, calculate the best possible alignment after considering both possible mappings between clusters and diagnoses.\nalignment_accuracy = max(\n    table[0, 0] + table[1, 1],\n    table[0, 1] + table[1, 0]\n) / table.sum()\n\n# Display the order of diagnosis categories used in the contingency table.\nprint("Rows:", list(diagnosis_var.values))\n\n# Display the order of cluster categories used in the contingency table\nprint("Columns:", list(cluster_var.values))\n\n# Display the number of observations for every diagnosis-cluster combination.\nprint("Contingency table:")\nprint(table)\n\n# Display the label-independent clustering agreement measures.\nprint(f"Adjusted Rand Index: {ari:.4f}")\nprint(f"Normalized Mutual Information: {nmi:.4f}")\n\n# Display the proportion of observations that agree after optimally associating each cluster with one diagnosis category. This is a descriptive post-hoc measure, not a supervised accuracy score.\nprint(f"Best label-cluster alignment: {alignment_accuracy:.4f}")\n\n# Return the original dataset so that it can still be used by other Orange widgets downstream.\nout_data = in_data', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
